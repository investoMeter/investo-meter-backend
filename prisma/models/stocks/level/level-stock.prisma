import { LevelStockPrice } from "level-stock-price"
import { Level } from "level"
import { LevelQuestion } from "level-question"

model LevelStock {
  id           Int          @id @default(autoincrement())
  name         String
  symbol       String       

  // relations
  questionId Int @unique
  question   LevelQuestion @relation(fields: [questionId], references: [id])
  
  priceHistory LevelStockPrice[]

  @@map("level_stocks")
}