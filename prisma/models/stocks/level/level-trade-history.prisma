import { Player } from "..\..\roles\player"
import { Level } from "./level"
import { LevelTrade } from "./level-trade"
import { LevelStock } from "./level-stock"
import { LevelMembership } from "./level-membership"

model LevelTradeHistory {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  LevelMembershipId Int
  levelMembership   LevelMembership @relation(fields: [LevelMembershipId], references: [id])

  trades     LevelTrade[]

}