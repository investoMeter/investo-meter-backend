import { LevelStock } from "./level-stock"
import { Level } from "./level"
import { TradeType } from "..\tradeType"

model LevelQuestion {
    id          Int      @id @default(autoincrement())
    levelId     Int

    position    Int
    answer      TradeType
    timestamp   DateTime

    levelStock  LevelStock? 
    level       Level @relation(fields: [levelId], references: [id])
}

