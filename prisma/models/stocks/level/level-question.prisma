import { LevelStock } from "./level-stock"
import { Level } from "./level"
import { TradeType } from "..\tradeType"

model LevelQuestion {
    id           Int      @id @default(autoincrement())
    position     Int
    answer       TradeType
    timestamp    DateTime

    // relations
    levelId Int
    level   Level @relation(fields: [levelId], references: [id])

    levelStock   LevelStock? 
}

