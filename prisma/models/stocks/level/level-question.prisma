import { LevelStock } from "./level-stock"
import { Level } from "./level"

model LevelQuestion {
    id           Int      @id @default(autoincrement())
    position        Int
    answer       TradeType
    timestamp    DateTime

    // relations
    levelId Int
    level   Level @relation(fields: [levelId], references: [id])

    levelStock   LevelStock? 
}

enum TradeType {
    SELL
    BUY
}