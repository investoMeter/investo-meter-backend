import { LevelStock } from "./level-stock"
import { LevelTradeHistory } from "./level-trade-history"
model LevelTrade {
    id        Int      @id @default(autoincrement())
    quantity  Int
    tradetype TradeType
    
    // relations
    stockId   Int
    stock     LevelStock    @relation(fields: [stockId], references: [id])

    tradeHistoryId Int
    tradeHistory   LevelTradeHistory @relation(fields: [tradeHistoryId], references: [id])
}

enum TradeType {
    BUY
    SELL
}
