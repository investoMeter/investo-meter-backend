import { LevelStock } from "level-stock"

model LevelStockPrice {
  id           Int      @id @default(autoincrement())
  openPrice    Float
  closePrice   Float
  highestPrice Float
  lowestPrice  Float
  volume       BigInt
  timeStamp    DateTime

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  Stock     LevelStock     @relation(fields: [levelStockId], references: [id], onDelete: Cascade)
  levelStockId   Int
}