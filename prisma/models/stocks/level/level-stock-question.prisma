import { TradeType } from "./level-trade"
import { LevelStock } from "./level-stock"

model LevelStockQuestion {
    id           Int      @id @default(autoincrement())
    answer       TradeType
    timestamp    DateTime

    // relations
    levelStockId Int @unique
    levelStock   LevelStock @relation(fields: [levelStockId], references: [id])
}