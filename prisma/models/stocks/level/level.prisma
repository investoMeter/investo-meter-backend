import { LevelStock } from "./level-stock"
import { Tutorial } from "tutorial"
import { LevelMembership } from "level-membership"

model Level {
    id             Int       @id @default(autoincrement())
    name           String
    startingBudget Float
    firstStar      Int
    secondStar     Int
    thirdStar      Int
    isActive       Boolean

    // relations
    tutorial       Tutorial?

    stocks         LevelStock[]

    memberships    LevelMembership[]
    
    @@map("levels")
    @@index([name], name: "name")
}
