import { ContestStock }from "./contest-stock"
import { ContestStockPrice }from "./contest-stock-price"
import { Room } from "./room"

model StockHistory {
  id            Int @id @default(autoincrement())
  currentShares Int
    // relations 
    contestStockId    Int 
    ContestStock      ContestStock        @relation(fields: [contestStockId], references: [id])

    roomNumber        Int
    roomContestId Int
    Room          Room?     @relation(fields: [roomContestId, roomNumber], references: [contestId, roomNumber])

    ContestStockPrice ContestStockPrice[]

    createdAt     DateTime  @default(now())
    updatedAt     DateTime? @updatedAt

    @@unique([roomContestId, roomNumber, contestStockId])
}
