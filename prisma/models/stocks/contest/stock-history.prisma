import { ContestStock }from "./contest-stock"
import { ContestStockPrice }from "./contest-stock-price"
import { Room } from "./room"
import { ContestContestStock } from "./contest-contest-stock"

model StockHistory {
  id                Int @id @default(autoincrement())
  stockId           Int
  contestId         Int
  roomNumber        Int

  currentShares Int
  createdAt         DateTime  @default(now())
  updatedAt         DateTime? @updatedAt

  stock             ContestContestStock @relation(fields: [contestId,stockId], references: [contestId,contestStockId], onDelete: Cascade)
  Room              Room?     @relation(fields: [contestId, roomNumber], references: [contestId, roomNumber])
  ContestStockPrice ContestStockPrice[]
  @@unique([contestId, roomNumber, stockId])
}
