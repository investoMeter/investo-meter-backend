import { Player } from "..\..\roles\player"
import { ContestStock } from ".\contest-stock"
import {  RequestStatus } from ".\RequestStatus"
import { Contest } from ".\contest"
import { Room } from ".\room"

model BuyRequest {
    id Int @id @default(autoincrement())

    quantity  Int
    price     Float
    timestamp DateTime      @default(now())
    status    RequestStatus

    // relations
    player   Player @relation(fields: [playerId], references: [userId])
    playerId String

    stock          ContestStock @relation(fields: [contestStockId], references: [id])
    contestStockId Int

    room   Room @relation(fields: [contestId, roomId], references: [contestId, id])
    roomId Int

    contest   Contest @relation(fields: [contestId], references: [id])
    contestId Int
}
