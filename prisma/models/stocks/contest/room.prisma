import { Contest } from "./contest"
import { ContestMembership }from "./contest-membership"
import { StockHistory } from "stock-history"

model Room {
    roomNumber      Int
    currentCapacity Int @default(0)

    // relations
    contestId Int
    contest   Contest @relation(fields: [contestId], references: [id])

    memberships     ContestMembership[]
    stocksHistories StockHistory[]

    @@id([contestId, roomNumber])
}
