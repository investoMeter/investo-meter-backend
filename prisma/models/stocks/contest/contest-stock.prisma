import { ContestStockPrice } from "./contest-stock-price"
import { Trade } from "trade"

model ContestStock {
  id           Int          @id @default(autoincrement())
  name         String
  symbol       String       @unique

  // relations
  relatedTrades Trade[]
  priceHistory  ContestStockPrice[]

  @@map("contest_stocks")
  @@index([symbol], name: "symbol")
}