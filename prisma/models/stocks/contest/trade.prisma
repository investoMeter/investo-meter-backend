import { ContestMembership } from "contest-membership"
import { TradeType }from "../tradeType"
import { ContestStock } from "./contest-stock"
import { Room } from "./room"
import { Contest } from "./contest"
import { ContestContestStock } from "./contest-contest-stock"

model Trade {
    id Int @id @default(autoincrement())

    quantity  Int
    price     Float
    timestamp DateTime  @default(now())

    // relations
    stockId Int
    contestId Int
    stock   ContestContestStock @relation(fields: [contestId,stockId], references: [contestId,contestStockId])

    buyerMembershipId Int
    buyerMembership   ContestMembership @relation(fields: [buyerMembershipId], references: [id],name: "buyerMembership")

    sellerMembershipId Int?
    sellerMembership ContestMembership? @relation(fields: [sellerMembershipId],  references: [id], name: "sellerMembership")

    room   Room @relation(fields: [contestId, roomNumber], references: [contestId, roomNumber])
    roomNumber Int
}

