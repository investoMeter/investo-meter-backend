import { User } from "..\..\roles\user"
import { ContestMembership }from "contest-membership"
import { ContestContestStock } from "./contest-contest-stock"
import { Room } from "./room"
import { ContestStock }from "./contest-stock"
import { BuyRequest } from "./buy-request"
import { SellRequest } from "./sell-request"
import { Trade } from "./trade"
import { ContestContestStock } from "contest-contest-stock"
import { Leaderboard } from "leaderboard"

model Contest {
    id Int @id @default(autoincrement())

    name            String
    maxRoomCapacity Int
    startingMoney   Float
    startingShares  Int

    startDate DateTime
    endDate   DateTime

    createdAt DateTime  @default(now())
    updatedAt DateTime? @updatedAt

    started Boolean @default(false)

    // relations
    creatorId String
    creator   User   @relation(fields: [creatorId], references: [id])

    rooms         Room[]
    contestStocks ContestContestStock[]
    leaderboards   Leaderboard[]

}


