import { ContestStock } from "./contest-stock"
import { StockHistory } from "./stock-history"
model ContestStockPrice {
  id        Int      @id @default(autoincrement())
  open      Float
  close     Float
  highest   Float
  lowest    Float
  volume    Int
  timeStamp DateTime @default(now())

  // relations
  StockHistory   StockHistory @relation(fields: [stockHistoryId], references: [id])
  stockHistoryId Int
  @@map("contest_stock_price")
}
