import { ContestStock } from "./contest-stock"
import { StockHistory } from "./stock-history"
model ContestStockPrice {
  id        Int      @id @default(autoincrement())
  open      Float
  close     Float
  highest   Float
  lowest    Float
  volume    BigInt
  timeStamp DateTime @default(now())

  // relations
  contestStockId Int
  StockHistory   StockHistory? @relation(fields: [stockHistoryId], references: [id])
  stockHistoryId Int?

  @@index([contestStockId], name: "contest_stock_price_contest_stock_id_foreign")
  @@map("contest_stock_price")
}
