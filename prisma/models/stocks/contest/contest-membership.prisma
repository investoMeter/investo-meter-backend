import { Player } from "..\..\roles\player"
import { Contest }from "./contest"
import { Trade } from "./trade"
import { Room }from "./room"
import {OwnedStock} from "./owned-stock"
import { BuyRequest } from ".\buy-request"
import { SellRequest } from ".\sell-request"

model ContestMembership {
    id Int @id @default(autoincrement())

    currentBalance Float @default(0.0)

    createdAt DateTime @default(now())
    
    updatedAt DateTime? @updatedAt
    
    // relations
    playerId String
    player   Player @relation(fields: [playerId], references: [userId])

    contestId  Int
    roomNumber Int
    room       Room     @relation(fields: [contestId, roomNumber], references:[contestId, roomNumber], onDelete: Cascade)

    buyerTrades Trade[] @relation("buyerMembership")
    sellerTrades Trade[] @relation("sellerMembership")
    BuyRequest            BuyRequest[]
    SellRequest           SellRequest[]

    ownedStocks    OwnedStock[]

    @@unique([contestId, playerId])
    @@index([contestId])
    @@index([contestId, roomNumber, currentBalance])
}
