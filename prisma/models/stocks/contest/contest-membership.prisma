import { Player } from "..\..\roles\player"
import { Contest }from "./contest"
import { Trade } from "./trade"
import { Room }from "./room"
import {OwnedStock} from "./owned-stock"
model ContestMembership {
    id Int @id @default(autoincrement())

    currentMoneyAmount Float @default(0.0)

    // relations
    playerId String
    player   Player @relation(fields: [playerId], references: [userId])

    contestId  Int
    roomNumber     Int
    room       Room     @relation(fields: [contestId, roomNumber], references:[contestId, roomNumber])

    tradingHistory Trade[]
    ownedStocks    OwnedStock[]

    @@unique([contestId, playerId])
}
