import { CommunityMembership } from "..\community\member"
import { Post } from "./post"


model Comment {
    id          String @id @default(cuid())
    userId      String
    communityId String
    postId      String

    text        String
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    post        Post @relation(fields: [postId], references: [id])
    author      CommunityMembership @relation(fields: [userId, communityId], references: [userId, communityId])
}