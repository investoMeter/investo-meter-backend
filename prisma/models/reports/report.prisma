import { Player } from "..\roles\player"
import { Admin } from "..\roles\admin"
import { ReportType } from "reportType"
import { ReportSeverity } from "reportSeverity"
import { ReportState } from "..\..\schema"
import { ReportState } from "reportState"

model Report {
  id         Int      @id @default(autoincrement())
  adminId    String?
  creatorId  String  
  
  content    String
  title      String
  type       ReportType
  state      ReportState   
  severity   ReportSeverity
  createdAt  DateTime @default(now())
  
  creator    Player    @relation(fields: [creatorId], references: [userId])
  admin      Admin?    @relation(fields: [adminId], references: [userId])
}
