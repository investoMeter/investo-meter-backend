
import { ReportSeverity }from /reportSeverity"
import { ReportType }from /reportType"
import { ReportState }from /reportState"
model Report {
  id         Int      @id @default(autoincrement())
  content    String
  adminId    String?
  creatorId  String  
  creator    Player    @relation(fields: [creatorId], references: [userId])
  admin      Admin?    @relation(fields: [adminId], references: [userId])
  title      String
  type       ReportType
  severity   ReportSeverity
  createdAt  DateTime @default(now())
  state      ReportState   

  @@map("report")
}
