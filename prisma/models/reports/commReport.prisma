import { Player } from "..\roles\player"
import { Admin } from "..\roles\admin"
import { CommunityReportIssueType } from "CommunityReportIssueType"
import { CommunityReportSubject } from "CommunityReportSubject"
import { ReportState } from "reportState"
model CommunityReport {
  id         Int           @id @default(autoincrement())
  adminId    String?
  creatorId  String
  subjectId  String
  content    String
  title      String
  subject    CommunityReportSubject
  issueType  CommunityReportIssueType
  state      ReportState
  createdAt  DateTime      @default(now())
  
  creator   Player  @relation(fields: [creatorId], references: [userId])
  admin     Admin?  @relation(fields: [adminId], references: [userId])
}