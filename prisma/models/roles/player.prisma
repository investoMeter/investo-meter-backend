import { User } from ".\user"
import { LevelMembership } from "..\stocks\level\level-membership"
import { ContestMembership } from "..\stocks\contest\contest-membership"
import { Level } from "..\stocks\level\level"
import { feedback } from "..\feedback"
import { Report } from "..\reports\report"
import { Community } from "..\community\community"
import { Post } from "..\feed\post"
import { CommunityMembership } from "..\community\member"
model Player {
  userId                String @unique

  coins                 Int  @default(0)
  // relations
  user                  User @relation(fields: [userId], references: [id])

  levelMemberships      LevelMembership[]
  contestMemberships    ContestMembership[]
  communityMemberships  CommunityMembership[]

  reports               Report[]
  communityReports      CommunityReport[]
  feedbacks             feedback[]
  ownedCommunities      Community[]

}
